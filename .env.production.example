# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Use this template for Vercel production deployment
# Set these in Vercel Dashboard: Settings > Environment Variables
# ============================================

# Application
NEXT_PUBLIC_APP_NAME="Fitness App"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_APP_URL="https://fitness-app.vercel.app"

# Node Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# Add your production API keys and secrets here
# (Set in Vercel Dashboard, not in this file)
